<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══ BASE GARMIN THEME ════════════════════════════════════════════════ -->
    <style name="Theme.WildTribeDrive" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/garmin_green</item>
        <item name="colorPrimaryVariant">@color/garmin_green_dim</item>
        <item name="colorOnPrimary">@color/garmin_bg_primary</item>
        <item name="colorSecondary">@color/garmin_amber</item>
        <item name="colorSurface">@color/garmin_bg_surface</item>
        <item name="colorOnSurface">@color/garmin_white</item>
        <item name="colorError">@color/garmin_red</item>
        <item name="android:windowBackground">@color/garmin_bg_primary</item>
        <item name="android:statusBarColor">@color/garmin_bg_primary</item>
        <item name="android:navigationBarColor">@color/garmin_bg_panel</item>
        <item name="android:textColorPrimary">@color/garmin_white</item>
        <item name="android:textColorSecondary">@color/garmin_gray_1</item>
    </style>

    <!-- ═══ SPLASH THEME (full-screen, black) ═══════════════════════════════ -->
    <style name="Theme.WildTribeDrive.Splash" parent="Theme.WildTribeDrive">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- ═══ DASHBOARD THEME (always dark, screen on) ═════════════════════════ -->
    <style name="Theme.WildTribeDrive.Dashboard" parent="Theme.WildTribeDrive">
        <item name="android:windowBackground">@color/garmin_bg_primary</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <!-- ═══ SETTINGS THEME (with ActionBar) ══════════════════════════════════ -->
    <style name="Theme.WildTribeDrive.Settings" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/garmin_green</item>
        <item name="colorPrimaryVariant">@color/garmin_green_dim</item>
        <item name="android:windowBackground">@color/garmin_bg_primary</item>
        <item name="android:statusBarColor">@color/garmin_bg_surface</item>
        <item name="actionBarStyle">@style/GarminActionBar</item>
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
        <item name="android:textColorPrimary">@color/garmin_white</item>
        <item name="android:textColorSecondary">@color/garmin_gray_1</item>
    </style>

    <style name="GarminActionBar" parent="Widget.MaterialComponents.Toolbar">
        <item name="background">@color/garmin_bg_surface</item>
        <item name="titleTextColor">@color/garmin_white</item>
        <item name="subtitleTextColor">@color/garmin_gray_1</item>
    </style>

    <!-- ═══ TEXT STYLES ═══════════════════════════════════════════════════════ -->

    <!-- Garmin data label: ALL CAPS, small, tracked -->
    <style name="TextStyle.GarminLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/garmin_gray_1</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- Garmin data value: monospace, large, bold -->
    <style name="TextStyle.GarminValue">
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">@color/garmin_white</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Large nav distance value -->
    <style name="TextStyle.GarminValueLarge">
        <item name="android:textSize">48sp</item>
        <item name="android:textColor">@color/garmin_white</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Medium widget value -->
    <style name="TextStyle.GarminValueMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/garmin_white</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══ BUTTON STYLES ═════════════════════════════════════════════════════ -->

    <!-- Primary Garmin button -->
    <style name="Widget.GarminButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/garmin_bg_elevated</item>
        <item name="android:textColor">@color/garmin_green</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="strokeColor">@color/garmin_gray_2</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Danger/red Garmin button -->
    <style name="Widget.GarminButton.Danger" parent="Widget.GarminButton">
        <item name="android:textColor">@color/garmin_red</item>
        <item name="strokeColor">@color/garmin_red</item>
    </style>

    <!-- Green action Garmin button -->
    <style name="Widget.GarminButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/garmin_green</item>
        <item name="android:textColor">@color/garmin_bg_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══ CARD STYLES ═══════════════════════════════════════════════════════ -->
    <style name="GarminCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/garmin_bg_surface</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/garmin_gray_3</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
