<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:keepScreenOn="true">

    <!-- ═══════════════════════════════════════════════════════════════════════
         TOP BAR
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- BLE Status – top left -->
    <LinearLayout
        android:id="@+id/layoutBleStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvBleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="16sp"
            android:textColor="@color/status_disconnected"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvBleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Make BLE status tappable for reconnect -->
    <View
        android:id="@+id/btnBleStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/layoutBleStatus"
        app:layout_constraintBottom_toBottomOf="@id/layoutBleStatus"
        app:layout_constraintStart_toStartOf="@id/layoutBleStatus"
        app:layout_constraintEnd_toEndOf="@id/layoutBleStatus" />

    <!-- GPS Time – top center -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/time_text_size"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:text="--:--"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Settings button – top right -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/label_settings"
        android:padding="@dimen/spacing_sm"
        android:layout_margin="@dimen/spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         NAVIGATION ARROW (Center)
         ═══════════════════════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/ivNavArrow"
        android:layout_width="@dimen/nav_arrow_size"
        android:layout_height="@dimen/nav_arrow_size"
        android:src="@drawable/ic_arrow_straight"
        android:tint="@color/nav_arrow_tint"
        android:contentDescription="Navigation arrow"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/tvTime"
        app:layout_constraintBottom_toTopOf="@id/tvNavInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.35" />

    <!-- Navigation instruction text -->
    <TextView
        android:id="@+id/tvNavInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/nav_waiting"
        style="@style/WildTribe.Text.NavInstruction"
        android:gravity="center"
        android:padding="@dimen/spacing_md"
        android:layout_marginHorizontal="@dimen/spacing_md"
        app:layout_constraintTop_toBottomOf="@id/ivNavArrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dividerHorizontal" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         BOTTOM WIDGET ROW
         ═══════════════════════════════════════════════════════════════════════ -->

    <View
        android:id="@+id/dividerHorizontal"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        app:layout_constraintBottom_toTopOf="@id/layoutWidgets"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutWidgets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/background_secondary"
        android:padding="@dimen/spacing_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Speed Widget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                style="@style/WildTribe.Text.Speed" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSpeedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:textSize="@dimen/speed_unit_text_size"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_speed"
                android:textSize="@dimen/widget_label_size"
                android:textColor="@color/text_hint"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"
            android:layout_marginVertical="@dimen/spacing_xs" />

        <!-- ETA Widget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="@dimen/widget_value_size"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_eta"
                android:textSize="@dimen/widget_label_size"
                android:textColor="@color/text_hint"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/divider"
            android:layout_marginVertical="@dimen/spacing_xs" />

        <!-- Distance Widget -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDistanceRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="@dimen/widget_value_size"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_distance"
                android:textSize="@dimen/widget_label_size"
                android:textColor="@color/text_hint"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SPEED WARNING OVERLAY
         ═══════════════════════════════════════════════════════════════════════ -->

    <LinearLayout
        android:id="@+id/layoutSpeedWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/warning_background"
        android:padding="@dimen/spacing_md"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slow_down"
            android:textSize="18sp"
            android:textColor="@color/warning_red"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         NOTIFICATION BANNER OVERLAY (5 second auto-dismiss)
         ═══════════════════════════════════════════════════════════════════════ -->

    <LinearLayout
        android:id="@+id/layoutNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/notification_bg"
        android:padding="@dimen/spacing_md"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutWidgets"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/notification_title_size"
            android:textColor="@color/orange_primary"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvNotificationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/notification_text_size"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
