<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_card"
    android:layout_marginHorizontal="@dimen/spacing_xs"
    android:layout_marginVertical="@dimen/spacing_xs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <!-- MotoRound badge (visible for highlighted devices) -->
        <TextView
            android:id="@+id/motoroundBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MotoRound"
            android:textSize="10sp"
            android:textColor="@color/background_primary"
            android:background="@color/orange_primary"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Device Name -->
        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/motoroundBadge" />

        <!-- Device MAC Address -->
        <TextView
            android:id="@+id/tvDeviceAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDeviceRssi" />

        <!-- RSSI value -->
        <TextView
            android:id="@+id/tvDeviceRssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/signal_good"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/motoroundBadge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnConnect" />

        <!-- Signal strength label -->
        <TextView
            android:id="@+id/tvSignalStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            app:layout_constraintTop_toBottomOf="@id/tvDeviceAddress"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="2dp" />

        <!-- Connect button -->
        <Button
            android:id="@+id/btnConnect"
            style="@style/WildTribe.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/connect"
            android:textSize="12sp"
            android:layout_marginTop="@dimen/spacing_sm"
            app:layout_constraintTop_toBottomOf="@id/tvSignalStrength"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
